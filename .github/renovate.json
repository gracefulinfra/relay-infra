{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":semanticCommits"],
  "labels": ["dependencies"],
  "schedule": ["before 6am on monday"],
  "timezone": "America/New_York",
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Group all minor, patch, digest, and pin updates into one weekly PR",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "non-major dependencies",
      "groupSlug": "non-major"
    }
  ],
  "customManagers": [
    {
      "description": "Versions annotated with '# renovate: datasource=... depName=...' in Makefiles and workflows",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Makefile$/", "/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\s+[A-Za-z0-9_-]+\\s*(\\?=|:=|=|:)\\s*\"?v?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "extractVersionTemplate": "^v?(?<version>.+)$"
    }
  ]
}
