{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "commonLabels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "buildInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment"],
      "properties": {
        "environment": { "type": "string", "enum": ["local", "provider-a", "provider-b"] }
      }
    }
  }
}
